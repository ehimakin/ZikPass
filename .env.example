ZIK_MIN_OLDEST_ACCOUNT_MONTHS=12
ZIK_COOLING_OFF_SECONDS=10

# Environment selector, independent of NODE_ENV. "demo" | "test" | "live".
# A deployed demo usually runs a production build, so demo tooling / the
# payment simulator / fixture reset are gated on THIS, not NODE_ENV.
# "live" is never selected implicitly and this milestone ships no live path.
ZIK_ENV=demo
# Client bundles only read NEXT_PUBLIC_* vars, so the environment badge and the
# demo-gated UI (e.g. the "Reset demo data" control) need this mirror.
NEXT_PUBLIC_ZIK_ENV=demo

# --- Apple Pay via Stripe Express Checkout (test mode). NOT wired in this
# --- milestone. Real Apple Pay is BLOCKED until these exist AND the HTTPS
# --- payment domain is registered in Stripe. See docs/SPRINT_STATUS.md.
# --- When NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is set the payment panel surfaces
# --- the Stripe route; otherwise the labelled "Zik demo checkout" simulator
# --- and pay-at-till are the only options.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Physical verification/session policy
ZIK_PHYSICAL_COOLING_OFF_SECONDS=0
ZIK_PHYSICAL_SESSION_TTL_SECONDS=900
ZIK_PHYSICAL_CODE_TTL_SECONDS=300
ZIK_PHYSICAL_DEVICE_AUTH_TTL_SECONDS=300

# Demo retail clerk terminal auth. This is a shared prototype secret, not a
# real per-terminal credential; see AUDIT.md C1 before any real deployment.
ZIK_DEMO_RETAIL_VERIFIER_TOKEN=demo-retail-terminal

# Generic store-portal login. When unset, demo/test environments use 8640.
# Live mode has no fallback and fails closed unless this is configured.
# ZIK_CLERK_LOGIN_CODE=8640

# Legacy mocked provider pipeline
ZIK_PROVIDER_LATENCY_MS=80
ZIK_BANK_MAX_ATTEMPTS=3

# Credential and device policy
ZIK_CREDENTIAL_TTL_HOURS=8760
ZIK_DEVICE_LIMIT_INCLUDED=2
ZIK_DEVICE_EXTENSION_PRICE_MINOR=299
ZIK_DEVICE_EXTENSION_CURRENCY=GBP

# Prototype payment allocation.
# Nonzero GBP test price for the pass (prototype fixture, not a commercial
# decision). Set to 0 to exercise the explicit free flow instead.
ZIK_PASS_ISSUANCE_PRICE_MINOR=199
ZIK_PLATFORM_SHARE_PERCENT=20

# Homepage splash suppression window
# Default: 120 seconds in development, 1800 seconds in production.
# This example uses the quieter production value; use 120 for local iteration.
ZIK_HOMEPAGE_SPLASH_SUPPRESS_SECONDS=1800

# Affiliate age-check demo lifetimes (seconds).
# ZIK_AFFILIATE_CHALLENGE_TTL_SECONDS=120
# ZIK_AFFILIATE_CODE_TTL_SECONDS=120

# --- Standalone JerkMeat affiliate (sibling repo ../jerkmeat, port 3001).
# --- Only needed to run the extracted external client; the embedded
# --- /affiliate-demo (client id "nightfall-demo") needs none of this.
# --- Absent config fails closed. Keep the secret in the ignored .env only.
# ZIK_JERKMEAT_REDIRECT_URI=http://localhost:3001/api/zik/callback
# ZIK_JERKMEAT_CLIENT_SECRET=change-me-to-match-jerkmeat-ZIK_CLIENT_SECRET

# --- Standalone PomHub affiliate (sibling repo ../pomhub, port 3002).
# ZIK_POMHUB_REDIRECT_URI=http://localhost:3002/api/zik/callback
# ZIK_POMHUB_CLIENT_SECRET=change-me-to-match-pomhub-ZIK_CLIENT_SECRET

# --- Standalone Pomography affiliate (sibling repo ../pomography, port 3003).
# ZIK_POMOGRAPHY_REDIRECT_URI=http://localhost:3003/api/zik/callback
# ZIK_POMOGRAPHY_CLIENT_SECRET=change-me-to-match-pomography-ZIK_CLIENT_SECRET

# Optional writable runtime directory. Leave unset for local data/.
# ZIK_RUNTIME_DATA_DIR=/absolute/path/to/runtime-data


# Explicit opt-in; all v1 disclosure endpoints fail closed otherwise.
ZIK_DISCLOSURE_V1=false
